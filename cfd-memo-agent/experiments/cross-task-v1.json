{
  "schema_version": 1,
  "benchmark_id": "cfd-memo-cross-task-v1",
  "frozen_at": "2026-10-06",
  "purpose": "Compare memory strategies across registered CFD task families without treating deterministic repeats as new samples.",
  "environment": {
    "openfoam_distribution": "Foundation",
    "openfoam_version": "10",
    "linux_backend": "WSL2 Ubuntu-22.04",
    "python": ">=3.12"
  },
  "model": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "timeout_seconds": 60,
    "max_output_tokens_per_call": 2000,
    "temperature_policy": "provider-default",
    "credential_source": "DEEPSEEK_API_KEY",
    "secrets_in_manifest": false
  },
  "groups": ["no_memory", "simple_cache", "retrieval_only", "cfd_memo"],
  "correction_budget": 2,
  "command_timeout_seconds": 1800,
  "partitions": [
    "same_family_new_parameters",
    "known_fault",
    "unknown_fault",
    "cross_family_transfer"
  ],
  "metrics": [
    "real_success_rate",
    "first_pass_rate",
    "mean_corrections",
    "elapsed_seconds",
    "input_tokens",
    "output_tokens",
    "estimated_cost",
    "effective_experience_reuse_rate",
    "failure_avoidance_rate"
  ],
