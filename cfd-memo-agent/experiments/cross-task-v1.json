  "success_definition": {
    "engineering_success": "real runner completes its trusted command plan and validates final field evidence",
    "first_pass": "round 0 reaches engineering_success without correction",
    "effective_memory_use": "episode records an effective usage outcome or prevention backed by source evidence",
    "physical_success": "reported separately and never inferred from engineering_success"
  },
  "limitations": [
    "M1 freezes task specifications and evaluation slots; it does not execute the 20 real evaluations.",
