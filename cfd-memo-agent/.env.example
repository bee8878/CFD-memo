# Copy this file to .env. Never put a real key in this tracked example.
# Default mode keeps the existing deterministic planner.
CFD_MEMO_MODEL_PROVIDER=rules

# Choose one provider locally: openai or deepseek.
CFD_MEMO_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

CFD_MEMO_MODEL_TIMEOUT=60
CFD_MEMO_MODEL_MAX_OUTPUT_TOKENS=2000
