{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/cfd-memo-agent/experience.schema.json",
  "title": "CFD-Memo Evidence-Backed Experience",
  "type": "object",
  "required": ["schema_version", "experience_id", "record_type", "status",
               "problem_codes", "applicability", "action", "evidence",
               "verification_scope", "trust", "user_control", "revision",
               "revision_history", "conflict_state", "conflicts", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": 3 },
    "experience_id": { "type": "string", "pattern": "^exp-[a-f0-9]{16}$" },
    "record_type": { "const": "repair_knowledge" },
    "status": {
      "enum": ["candidate", "config_verified", "run_verified", "physics_verified"]
    },
    "problem_codes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string" }
    },
    "applicability": {
      "type": "object",
      "required": ["case_type", "solver", "flow_model", "dimension"],
      "properties": {
        "case_type": { "type": "string" },
        "solver": { "type": "string" },
        "flow_model": { "type": "string" },
        "dimension": { "type": "string" },
        "source_reynolds_number": { "type": "number" }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object", "required": ["type", "files"],
      "properties": {
        "type": { "const": "restore_from_trusted_reference" },
        "files": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["0/U", "0/p", "constant/physicalProperties"] }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_type", "episode_id", "from_round", "to_round",
                     "outcome_status", "runner_mode", "derived_level",
                     "integrity_verified", "artifacts"],
        "properties": {
          "source_type": { "enum": ["episode_attempt", "legacy_episode"] },
          "episode_id": { "type": "string" },
          "from_round": { "type": "integer", "minimum": 0 },
          "to_round": { "type": "integer", "minimum": 1 },
          "outcome_status": { "type": "string" },
          "runner_mode": { "enum": ["simulated", "real", "unknown"] },
          "derived_level": {
            "enum": ["candidate", "config_verified", "run_verified", "physics_verified"]
          },
          "integrity_verified": { "type": "boolean" },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role", "path", "size_bytes", "sha256"],
              "properties": {
                "role": { "type": "string" },
                "path": { "type": "string" },
                "size_bytes": { "type": "integer", "minimum": 0 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "verification_scope": {
      "enum": ["candidate", "configuration", "run", "physics"]
    },
    "trust": {
      "type": "object",
      "required": ["positive_outcomes", "negative_outcomes", "confidence", "evaluated_episode_ids"],
      "properties": {
        "positive_outcomes": { "type": "integer", "minimum": 0 },
        "negative_outcomes": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evaluated_episode_ids": {
          "type": "array", "uniqueItems": true, "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "user_control": {
      "type": "object",
      "required": ["state", "approved", "note", "updated_at"],
      "properties": {
        "state": { "enum": ["active", "disabled"] },
        "approved": { "type": "boolean" },
        "note": { "type": ["string", "null"] },
        "updated_at": { "type": "string" }
      },
      "additionalProperties": false
    },
    "usage_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["episode_id", "agent", "round_index", "decision", "effect",
                     "outcome", "recorded_at"],
        "properties": {
          "episode_id": { "type": "string" },
          "agent": { "enum": ["planner", "case_writer", "reviewer"] },
          "round_index": { "type": "integer", "minimum": 0 },
          "decision": { "type": "string" },
          "effect": { "type": "string" },
          "outcome": { "enum": ["effective", "ineffective"] },
          "recorded_at": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "revision": { "type": "integer", "minimum": 1 },
    "revision_history": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["revision", "event", "at", "source_episode_id", "details_sha256"],
        "properties": {
          "revision": { "type": "integer", "minimum": 1 },
          "event": {
            "enum": ["created", "evidence_merged", "trust_updated",
                     "user_control_updated", "conflict_detected", "conflict_resolved"]
          },
          "at": { "type": "string" },
          "source_episode_id": { "type": ["string", "null"] },
          "details_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "conflict_state": { "enum": ["clear", "conflicted"] },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["experience_id", "reason", "status", "detected_at", "resolved_at"],
        "properties": {
          "experience_id": { "type": "string" },
          "reason": { "type": "string" },
          "status": { "enum": ["active", "resolved"] },
          "detected_at": { "type": "string" },
          "resolved_at": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": false
}
