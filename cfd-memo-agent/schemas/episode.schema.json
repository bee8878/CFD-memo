{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/cfd-memo-agent/episode.schema.json",
  "title": "CFD-Memo Episode",
  "type": "object",
  "required": ["episode_id", "task_id", "mode", "status", "case_summary", "log_summary", "reflection", "reuse_tags"],
  "properties": {
    "episode_id": { "type": "string" },
    "task_id": { "type": ["string", "null"] },
    "mode": { "enum": ["no_memory", "simple_cache", "retrieval_only", "cfd_memo"] },
    "status": { "enum": ["success", "failed", "simulated_success", "simulated_failed", "completed", "proposal_ready", "blocked", "timeout", "execution_error", "interrupted"] },
    "case_summary": {
      "type": ["object", "null"],
      "required": ["case_type", "solver", "case_path"],
      "properties": {
        "case_type": { "type": "string" },
        "solver": { "type": "string" },
        "case_path": { "type": "string" },
        "generated_files": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "log_summary": {
      "type": ["object", "null"],
      "required": ["log_path", "error_type", "residual_summary"],
      "properties": {
        "log_path": { "type": "string" },
        "error_type": { "type": ["string", "null"] },
        "residual_summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "diagnosis": {
      "type": "object",
      "properties": {
        "root_cause": { "type": "string" },
        "suggested_fix": { "type": "string" },
        "correction_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "reflection": {
      "type": "object",
      "required": ["success_factors", "failure_causes", "reusable_rules"],
      "properties": {
        "success_factors": { "type": "array", "items": { "type": "string" } },
        "failure_causes": { "type": "array", "items": { "type": "string" } },
        "reusable_rules": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "reuse_tags": { "type": "array", "items": { "type": "string" } },
    "schema_version": { "enum": [2, 3] },
    "task": { "type": ["object", "null"] },
    "input": {
      "type": "object",
      "required": ["kind", "description", "task_path", "raw_text"],
      "properties": {
        "kind": { "enum": ["description", "task_file"] },
        "description": { "type": ["string", "null"] },
        "task_path": { "type": ["string", "null"] },
        "raw_text": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "runner_mode": { "enum": ["simulated", "real"] },
    "planning": {
      "type": "object",
      "required": ["status", "requested_provider", "actual_mode", "fallback_used",
                   "fallback_reason", "model", "prompt_version", "trace",
                   "assumptions", "questions", "experience_ids", "error"],
      "properties": {
        "status": { "enum": ["pending", "ready", "reference_proposal", "needs_clarification", "failed", "not_applicable"] },
        "requested_provider": { "type": ["string", "null"] },
        "actual_mode": { "enum": ["rules", "openai", "deepseek", "rules_fallback", "task_file", null] },
        "fallback_used": { "type": "boolean" },
        "fallback_reason": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] },
        "trace": { "type": ["object", "null"] },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "questions": { "type": "array", "items": { "type": "string" } },
        "experience_ids": {
          "type": "array", "uniqueItems": true, "items": { "type": "string" }
        },
        "tutorial_ids": {
          "type": "array", "uniqueItems": true, "items": { "type": "string" }
        },
        "case_spec_proposal": { "type": ["object", "null"] },
        "tutorial_retrieval": {
          "type": "object",
          "required": ["status", "query", "index_path", "candidate_count", "candidates", "error"],
          "properties": {
            "status": { "enum": ["pending", "not_needed", "not_applicable", "ready", "no_match", "unavailable"] },
            "query": { "type": ["string", "null"] },
            "index_path": { "type": ["string", "null"] },
            "candidate_count": { "type": "integer", "minimum": 0 },
            "candidates": { "type": "array", "items": { "type": "object" } },
            "error": {
              "type": ["object", "null"],
              "required": ["type", "message"],
              "properties": {
                "type": { "type": "string" },
                "message": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "error": {
          "type": ["object", "null"],
          "required": ["type", "message"],
          "properties": {
            "type": { "type": "string" },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "case_writing": {
      "type": "object",
      "required": ["status", "requested_provider", "actual_mode", "fallback_used",
                   "fallback_reason", "model", "prompt_version", "trace", "intent",
                   "rationale", "warnings", "blockers", "experience_ids",
                   "preventive_files", "error"],
      "properties": {
        "status": { "enum": ["pending", "ready", "blocked", "failed"] },
        "requested_provider": { "type": ["string", "null"] },
        "actual_mode": { "enum": ["rules", "openai", "deepseek", "rules_fallback", null] },
        "fallback_used": { "type": "boolean" },
        "fallback_reason": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] },
        "trace": { "type": ["object", "null"] },
        "intent": { "type": ["object", "null"] },
        "rationale": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "experience_ids": {
          "type": "array", "uniqueItems": true, "items": { "type": "string" }
        },
        "preventive_files": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["0/U", "0/p", "constant/physicalProperties"] }
        },
        "error": {
          "type": ["object", "null"],
          "required": ["type", "message"],
          "properties": {
            "type": { "type": "string" },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "physical_validated": { "const": false },
    "preflight": {
      "type": ["object", "null"],
      "required": ["schema_version", "status", "task_path", "task_id", "task_sha256",
                   "runner_mode", "parameters", "assumptions", "questions",
                   "validation_errors", "validation_warnings", "memory", "risks",
                   "confirmation_required", "confirmation_token", "confirmation", "next_action"],
      "properties": {
        "schema_version": { "const": 1 },
        "status": { "enum": ["ready", "needs_input"] },
        "task_path": { "type": "string" },
        "task_id": { "type": ["string", "null"] },
        "task_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "runner_mode": { "enum": ["simulated", "real"] },
        "parameters": { "type": "object" },
        "plan_path": { "type": ["string", "null"] },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "questions": { "type": "array", "items": { "type": "string" } },
        "validation_errors": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "validation_warnings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "memory": { "type": "object" },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "confirmation_required": { "type": "boolean" },
        "confirmation_token": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "confirmation": {
          "type": ["object", "null"],
          "required": ["confirmed", "confirmed_at", "token_sha256"],
          "properties": {
            "confirmed": { "const": true },
            "confirmed_at": { "type": "string" },
            "token_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "next_action": { "type": "string" }
      },
      "additionalProperties": false
    },
    "started_at": { "type": "string" },
    "workflow_path": { "type": "string" },
    "episode_path": { "type": "string" },
    "report_path": { "type": "string" },
    "max_corrections": { "type": "integer", "minimum": 0 },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "stop_reason": {
      "type": "object",
      "required": ["code", "message"],
      "properties": { "code": { "type": "string" }, "message": { "type": "string" } },
      "additionalProperties": false
    },
    "injected_fault": {
      "type": ["object", "null"],
      "required": ["name", "changes"],
      "properties": {
        "name": { "enum": ["missing-boundary", "bad-transport"] },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } }
      },
      "additionalProperties": false
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_round", "to_round", "reason_codes", "changes"],
        "properties": {
          "from_round": { "type": "integer", "minimum": 0 },
          "to_round": { "type": "integer", "minimum": 1 },
          "reason_codes": { "type": "array", "items": { "type": "string" } },
          "changes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/change" } }
        },
        "additionalProperties": false
      }
    },
    "preventions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["round_index", "experience_ids", "files", "action"],
        "properties": {
          "round_index": { "type": "integer", "minimum": 0 },
          "experience_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string" }
          },
          "files": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "enum": ["0/U", "0/p", "constant/physicalProperties"] }
          },
          "action": { "const": "restore_from_trusted_reference" }
        },
        "additionalProperties": false
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["round_index", "review_path", "status", "requested_provider",
                     "actual_mode", "fallback_used", "fallback_reason", "model",
                     "prompt_version", "trace", "decision", "finding_codes", "experience_ids",
                     "repair_scope", "root_cause", "recommendation",
                     "applicability_conditions", "limitations", "error"],
        "properties": {
          "round_index": { "type": "integer", "minimum": 0 },
          "review_path": { "type": "string" },
          "status": { "enum": ["reviewed", "failed"] },
          "requested_provider": { "type": ["string", "null"] },
          "actual_mode": { "enum": ["rules", "openai", "deepseek", "rules_fallback", null] },
          "fallback_used": { "type": "boolean" },
          "fallback_reason": { "type": ["string", "null"] },
          "model": { "type": ["string", "null"] },
          "prompt_version": { "type": ["string", "null"] },
          "trace": { "type": ["object", "null"] },
          "decision": { "enum": ["accept", "repair", "stop", null] },
          "finding_codes": { "type": "array", "items": { "type": "string" } },
          "experience_ids": { "type": "array", "items": { "type": "string" } },
          "repair_scope": { "enum": ["none", "boundary_fields", "transport", "boundary_and_transport"] },
          "root_cause": { "type": "string" },
          "recommendation": { "type": "string" },
          "applicability_conditions": { "type": "array", "items": { "type": "string" } },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "error": {
            "type": ["object", "null"],
            "required": ["type", "message"],
            "properties": {
              "type": { "type": "string" },
              "message": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "run_path", "case_path", "status", "execution_path", "validation_path",
                     "config_valid", "log_paths", "residuals", "findings", "runtime_blockers"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "run_path": { "type": "string" },
          "case_path": { "type": ["string", "null"] },
          "status": { "enum": ["preparing", "validation_failed", "simulated_success", "completed",
                               "failed", "blocked", "environment_error", "timeout", "execution_error", "interrupted"] },
          "execution_path": { "type": ["string", "null"] },
          "validation_path": { "type": ["string", "null"] },
          "config_valid": { "type": "boolean" },
          "environment": { "type": ["object", "null"] },
          "mesh_evidence": { "type": ["object", "null"] },
          "result_evidence": { "type": ["object", "null"] },
          "log_paths": { "type": "array", "items": { "type": "string" } },
          "residuals": { "type": "array", "items": { "type": "object" } },
          "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
          "runtime_blockers": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "elapsed_seconds": { "type": "number", "minimum": 0 },
        "config_valid": { "type": "boolean" },
        "experience_reused": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "tutorial_resume": {
      "type": "object",
      "required": ["parent_episode_id", "parent_workflow_path", "approval_path",
                   "build_path", "approved"],
      "properties": {
        "parent_episode_id": { "type": "string", "minLength": 1 },
        "parent_workflow_path": { "type": "string", "minLength": 1 },
        "approval_path": { "type": "string", "minLength": 1 },
        "build_path": { "type": ["string", "null"] },
        "approved": { "const": true }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "required": ["store_path", "retrieved_experience_ids", "uses",
                   "retrievals",
                   "learned_experience_ids", "learned_procedure_ids",
                   "archived_episode_path", "learning_enabled", "cache_key",
                   "cache_hit", "cached_case_path"],
      "properties": {
        "store_path": { "type": "string" },
        "retrieved_experience_ids": {
          "type": "array", "uniqueItems": true, "items": { "type": "string" }
        },
        "retrievals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stage", "query", "vector_version", "embedding_provider",
                         "embedding_version", "matches"],
            "properties": {
              "stage": { "enum": ["planner", "case_writer", "reviewer"] },
              "query": { "type": "string" },
              "vector_version": { "type": "string" },
              "embedding_provider": { "type": "string", "minLength": 1 },
              "embedding_version": { "type": "string", "minLength": 1 },
              "matches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["experience_id", "vector_score", "semantic_score",
                               "reynolds_score", "confidence", "final_score", "reasons"],
                  "properties": {
                    "experience_id": { "type": "string" },
                    "vector_score": { "type": "number", "minimum": 0, "maximum": 1 },
                    "semantic_score": { "type": "number", "minimum": 0, "maximum": 1 },
                    "reynolds_score": { "type": "number", "minimum": 0, "maximum": 1 },
                    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                    "final_score": { "type": "number", "minimum": 0, "maximum": 1 },
                    "reasons": {
                      "type": "array", "minItems": 1, "items": { "type": "string" }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "uses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["experience_id", "agent", "round_index", "decision", "effect",
                         "outcome", "outcome_episode_id"],
            "properties": {
              "experience_id": { "type": "string" },
              "agent": { "enum": ["planner", "case_writer", "reviewer"] },
              "round_index": { "type": "integer", "minimum": 0 },
              "decision": { "type": "string" },
              "effect": { "type": "string" },
              "outcome": { "enum": ["pending", "effective", "ineffective"] },
              "outcome_episode_id": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "learned_experience_ids": {
          "type": "array", "uniqueItems": true, "items": { "type": "string" }
        },
        "learned_procedure_ids": {
          "type": "array", "uniqueItems": true, "items": { "type": "string" }
        },
        "archived_episode_path": { "type": ["string", "null"] }
        ,
        "learning_enabled": { "type": "boolean" },
        "cache_key": { "type": ["string", "null"] },
        "cache_hit": { "type": "boolean" },
        "cached_case_path": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["code", "message", "location"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "location": { "type": "string" },
        "evidence": { "type": "string" },
        "action": { "enum": ["rule_candidate", "user_clarification", "manual_required"] },
        "suggestion": { "type": "string" }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": ["file", "before", "after"],
      "properties": {
        "file": { "enum": ["0/U", "0/p", "constant/physicalProperties"] },
        "before": { "type": "string" },
        "after": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["schema_version"],
        "properties": { "schema_version": { "const": 2 } }
      },
      "then": {
        "required": ["task", "input", "runner_mode", "physical_validated", "started_at",
                     "workflow_path", "episode_path", "report_path", "max_corrections",
                     "findings", "stop_reason", "rounds", "corrections", "injected_fault",
                     "preventions", "metrics", "diagnosis", "planning", "case_writing", "reviews"],
        "properties": {
          "mode": { "const": "no_memory" },
          "status": { "enum": ["simulated_success", "completed", "proposal_ready", "failed", "blocked", "timeout", "execution_error", "interrupted"] },
          "metrics": { "properties": { "experience_reused": { "const": false } } }
        }
      }
    },
    {
      "if": {
        "required": ["schema_version"],
        "properties": { "schema_version": { "const": 3 } }
      },
      "then": {
        "required": ["task", "input", "runner_mode", "physical_validated", "started_at",
                     "workflow_path", "episode_path", "report_path", "max_corrections",
                     "findings", "stop_reason", "rounds", "corrections", "injected_fault",
                     "preventions", "metrics", "diagnosis", "planning", "case_writing", "reviews", "memory"],
        "properties": {
          "mode": { "enum": ["simple_cache", "retrieval_only", "cfd_memo"] },
          "status": { "enum": ["simulated_success", "completed", "proposal_ready", "failed", "blocked", "timeout", "execution_error", "interrupted"] }
        }
      }
    }
  ]
}
