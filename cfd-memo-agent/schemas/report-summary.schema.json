{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/cfd-memo-agent/report-summary.schema.json",
  "title": "CFD-Memo User Report Summary",
  "type": "object",
  "required": ["schema_version", "episode_id", "task", "execution", "physical_result",
               "memory_contribution", "outputs", "next_steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "episode_id": { "type": ["string", "null"] },
    "task": {
      "type": "object",
      "required": ["objective", "task_id", "case_type", "solver", "parameters"],
      "properties": {
        "objective": { "type": "string" },
        "task_id": { "type": ["string", "null"] },
        "case_type": { "type": ["string", "null"] },
        "solver": { "type": ["string", "null"] },
        "parameters": { "type": "object" }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["status", "status_label", "completed", "runner_mode", "comparison_mode",
                   "round_count", "correction_count", "elapsed_seconds", "stop_reason"],
      "properties": {
        "status": { "type": "string" },
        "status_label": { "type": "string" },
        "completed": { "type": "boolean" },
        "runner_mode": { "type": ["string", "null"] },
        "comparison_mode": { "type": ["string", "null"] },
        "round_count": { "type": "integer", "minimum": 0 },
        "correction_count": { "type": "integer", "minimum": 0 },
        "elapsed_seconds": { "type": "number", "minimum": 0 },
        "stop_reason": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "physical_result": {
      "type": "object",
      "required": ["validated", "verdict", "explanation", "result_evidence"],
      "properties": {
        "validated": { "type": "boolean" },
        "verdict": { "enum": ["validated", "not_validated", "no_completed_run"] },
        "explanation": { "type": "string" },
        "result_evidence": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "memory_contribution": {
      "type": "object",
      "required": ["mode", "retrieved_experience_ids", "used_experience_ids",
                   "effective_experience_ids", "prevented_files", "learned_record_ids",
                   "conclusion"],
      "properties": {
        "mode": { "type": "string" },
        "retrieved_experience_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "used_experience_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "effective_experience_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "prevented_files": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "learned_record_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "conclusion": { "type": "string" }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": ["episode", "report", "summary", "task", "case", "logs"],
      "properties": {
        "episode": { "type": ["string", "null"] },
        "report": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] },
        "task": { "type": ["string", "null"] },
        "case": { "type": ["string", "null"] },
        "logs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "next_steps": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
